{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indynull.github.io/anqa/schemas/control.schema.json",
  "title": "anqa-control",
  "description": "JSON-RPC 2.0 control protocol for anqad (protocolVersion 1.0.0).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "minProtocolVersion",
    "methods",
    "notifications",
    "catalogQuery"
  ],
  "properties": {
    "catalogQuery": {
      "description": "session/list query language (tokens, values, operators).",
      "const": {
        "bareWords": "title, sessionId, and label",
        "implicitAnd": true,
        "operators": [
          "AND",
          "OR",
          "NOT",
          "-"
        ],
        "compare": [
          ">=",
          "<=",
          ">",
          "<",
          "="
        ],
        "counts": [
          {
            "flag": "workflow",
            "count": "workflows",
            "field": "workflowCount"
          },
          {
            "flag": "note",
            "count": "notes",
            "field": "noteCount"
          },
          {
            "flag": "goal",
            "count": "goals",
            "field": "goalCount"
          },
          {
            "flag": "plan",
            "count": "plans",
            "field": "planCount"
          },
          {
            "flag": "subagent",
            "count": "subagents",
            "field": "subagentCount"
          },
          {
            "flag": "task",
            "count": "tasks",
            "field": "taskCount"
          },
          {
            "flag": "job",
            "count": "jobs",
            "field": "jobCount"
          },
          {
            "flag": "schedule",
            "count": "schedules",
            "field": "scheduleCount"
          },
          {
            "flag": "error",
            "count": "errors",
            "field": "errorCount"
          },
          {
            "flag": "failure",
            "count": "failures",
            "field": "failureCount"
          },
          {
            "flag": "diff",
            "count": "diff",
            "field": "diffLineCount"
          },
          {
            "flag": "compaction",
            "count": "compaction",
            "field": "compactionCount"
          },
          {
            "flag": "doom",
            "count": "doom",
            "field": "doomCount"
          }
        ],
        "tokens": [
          {
            "name": "is",
            "role": "Status or origin.",
            "values": [
              "running",
              "awaiting",
              "ending",
              "complete",
              "cancelled",
              "idle",
              "host",
              "import"
            ],
            "compare": false
          },
          {
            "name": "has",
            "role": "Presence (has:plan). Counts use the written pair (plans:>=2).",
            "values": [
              "workflow",
              "note",
              "goal",
              "plan",
              "subagent",
              "task",
              "job",
              "schedule",
              "error",
              "failure",
              "diff",
              "compaction",
              "doom",
              "git",
              "context"
            ],
            "compare": false,
            "countFields": {
              "workflow": "workflowCount",
              "note": "noteCount",
              "goal": "goalCount",
              "plan": "planCount",
              "subagent": "subagentCount",
              "task": "taskCount",
              "job": "jobCount",
              "schedule": "scheduleCount",
              "error": "errorCount",
              "failure": "failureCount",
              "diff": "diffLineCount",
              "compaction": "compactionCount",
              "doom": "doomCount"
            }
          },
          {
            "name": "in",
            "role": "Directory the session was run in.",
            "values": [],
            "compare": false
          },
          {
            "name": "harness",
            "role": "Disk adapter id.",
            "values": [
              "grok",
              "opencode",
              "pi",
              "claude",
              "gemini",
              "antigravity",
              "copilot",
              "codex",
              "cursor"
            ],
            "compare": false
          },
          {
            "name": "model",
            "role": "Model id substring.",
            "values": [],
            "compare": false
          },
          {
            "name": "task",
            "role": "Task id substring.",
            "values": [],
            "compare": false
          },
          {
            "name": "workflows",
            "role": "Count of workflows.",
            "values": [],
            "compare": true
          },
          {
            "name": "notes",
            "role": "Count of notes.",
            "values": [],
            "compare": true
          },
          {
            "name": "goals",
            "role": "Count of goals.",
            "values": [],
            "compare": true
          },
          {
            "name": "plans",
            "role": "Count of plans.",
            "values": [],
            "compare": true
          },
          {
            "name": "subagents",
            "role": "Count of subagents.",
            "values": [],
            "compare": true
          },
          {
            "name": "tasks",
            "role": "Count of tasks.",
            "values": [],
            "compare": true
          },
          {
            "name": "jobs",
            "role": "Count of jobs.",
            "values": [],
            "compare": true
          },
          {
            "name": "schedules",
            "role": "Count of schedules.",
            "values": [],
            "compare": true
          },
          {
            "name": "errors",
            "role": "Count of errors.",
            "values": [],
            "compare": true
          },
          {
            "name": "failures",
            "role": "Count of failures.",
            "values": [],
            "compare": true
          },
          {
            "name": "turns",
            "role": "turnCount.",
            "values": [],
            "compare": true
          },
          {
            "name": "tools",
            "role": "toolCallCount.",
            "values": [],
            "compare": true
          },
          {
            "name": "events",
            "role": "numEvents.",
            "values": [],
            "compare": true
          },
          {
            "name": "duration",
            "role": "Session length (1h, 2d, 30m).",
            "values": [],
            "compare": true
          },
          {
            "name": "diff",
            "role": "Diff line count.",
            "values": [],
            "compare": true
          },
          {
            "name": "compaction",
            "role": "Compaction count.",
            "values": [],
            "compare": true
          },
          {
            "name": "doom",
            "role": "Doom-loop warnings.",
            "values": [],
            "compare": true
          },
          {
            "name": "after",
            "role": "updatedAt on or after this time (ISO, yesterday, 2d, 2 days ago).",
            "values": [],
            "compare": false
          },
          {
            "name": "before",
            "role": "updatedAt on or before this time (ISO, yesterday, 2d, 2 days ago).",
            "values": [],
            "compare": false
          }
        ],
        "scopes": {
          "turns": {
            "tokens": [
              {
                "name": "has",
                "role": "Presence on this turn.",
                "values": [
                  "error",
                  "subagent"
                ],
                "compare": false
              },
              {
                "name": "errors",
                "role": "Error count.",
                "values": [],
                "compare": true
              },
              {
                "name": "tools",
                "role": "Tool-call count.",
                "values": [],
                "compare": true
              },
              {
                "name": "events",
                "role": "Event count.",
                "values": [],
                "compare": true
              },
              {
                "name": "duration",
                "role": "Turn length (1h, 30m).",
                "values": [],
                "compare": true
              },
              {
                "name": "subagents",
                "role": "Child count.",
                "values": [],
                "compare": true
              }
            ]
          },
          "timeline": {
            "tokens": [
              {
                "name": "is",
                "role": "Event kind.",
                "values": [
                  "tool",
                  "user",
                  "assistant",
                  "error",
                  "session",
                  "subagent",
                  "background",
                  "workflow"
                ],
                "compare": false
              },
              {
                "name": "has",
                "role": "Presence on this event.",
                "values": [
                  "error"
                ],
                "compare": false
              },
              {
                "name": "tool",
                "role": "Tool name substring.",
                "values": [],
                "compare": false
              },
              {
                "name": "turn",
                "role": "Turn number.",
                "values": [],
                "compare": true
              },
              {
                "name": "user",
                "role": "User-message text substring.",
                "values": [],
                "compare": false
              },
              {
                "name": "errors",
                "role": "This event is an error (0 or 1).",
                "values": [],
                "compare": true
              },
              {
                "name": "duration",
                "role": "Time on this event (Dur; 1h, 30s).",
                "values": [],
                "compare": true
              }
            ]
          }
        }
      }
    },
    "protocolVersion": {
      "const": "1.0.0",
      "description": "Owner initialize protocolVersion."
    },
    "minProtocolVersion": {
      "const": "1.0.0",
      "description": "Oldest protocolVersion this owner accepts."
    },
    "methods": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialize",
        "session/list",
        "session/overview",
        "session/timeline",
        "session/turns",
        "session/diff",
        "session/open",
        "session/import",
        "session/render",
        "diagnostics",
        "notes/list",
        "notes/upsert",
        "notes/delete"
      ],
      "properties": {
        "initialize": {
          "description": "Handshake (owner reports `protocolVersion` `1.0.0`)",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "params": {
              "title": "initialize params",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "protocolVersion": {
                  "description": "Client protocol version (same major as the owner).",
                  "type": "string"
                },
                "clientInfo": {
                  "description": "Optional client name and version.",
                  "type": "object"
                }
              },
              "required": [
                "protocolVersion"
              ]
            },
            "result": {
              "title": "initialize result",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "protocolVersion": {
                  "description": "Owner protocol version.",
                  "type": "string"
                },
                "capabilities": {
                  "description": "Method names the owner implements after handshake.",
                  "type": "array"
                },
                "renderFormats": {
                  "description": "Values ``session/render`` accepts for ``format``.",
                  "type": "array"
                }
              },
              "required": [
                "protocolVersion",
                "capabilities",
                "renderFormats"
              ]
            }
          },
          "required": [
            "params"
          ]
        },
        "session/list": {
          "description": "Catalog page (see below)",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "params": {
              "title": "session/list params",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "query": {
                  "description": "Catalog query language (see catalogQuery in this schema).",
                  "type": "string"
                },
                "limit": {
                  "description": "Page size.",
                  "type": "integer"
                },
                "offset": {
                  "description": "Page start; omit for the first page.",
                  "type": "integer"
                },
                "sinceRevision": {
                  "description": "When this matches the owner revision, the page is empty (`unchanged`). A client that is behind may receive a `delta` (upserted rows plus `removed` ids).",
                  "type": "integer"
                }
              }
            },
            "result": {
              "title": "session/list result",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "sessions": {
                  "description": "Catalog rows.",
                  "type": "array"
                },
                "total": {
                  "description": "Unfiltered catalog size.",
                  "type": "integer"
                },
                "matched": {
                  "description": "Rows matching ``query``.",
                  "type": "integer"
                },
                "revision": {
                  "description": "Catalog revision.",
                  "type": "integer"
                }
              }
            }
          },
          "required": [
            "params"
          ]
        },
        "session/overview": {
          "description": "Meta + turns + notes + event/tool counts (`stats`). Turns include `subagentRuns`. Also `backgroundJobs`, `schedules`, and `workflows` (no log or script bodies).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "params": {
              "title": "session/overview params",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "session": {
                  "description": "Session id or path.",
                  "type": "string"
                }
              },
              "required": [
                "session"
              ]
            },
            "result": {
              "title": "session/overview result",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "backgroundJobs": {
                  "description": "Background shell and monitor rows.",
                  "type": "array"
                },
                "schedules": {
                  "description": "Durable scheduler rows.",
                  "type": "array"
                },
                "workflows": {
                  "description": "Workflow run rows.",
                  "type": "array"
                },
                "stats": {
                  "description": "Full-session event type and tool counts (`eventTypes`, `tools`).",
                  "type": "object"
                }
              }
            }
          },
          "required": [
            "params"
          ]
        },
        "session/timeline": {
          "description": "Paged events (`offset`, `limit`, `type`, `kind`, `query`, `promptIndex`, `aroundIndex`, `atIndex`, `contentChars`). Spawn/finish rows include `childSessionId` and finish stats.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "params": {
              "title": "session/timeline params",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "session": {
                  "description": "Session id or path.",
                  "type": "string"
                },
                "offset": {
                  "description": "Filtered page start.",
                  "type": "integer"
                },
                "limit": {
                  "description": "Page size.",
                  "type": "integer"
                },
                "type": {
                  "description": "Event type filter (also accepted as `eventType`).",
                  "type": "string"
                },
                "kind": {
                  "description": "Kind filter (tools, user, assistant, \u2026).",
                  "type": "string"
                },
                "query": {
                  "description": "Substring match over the event body.",
                  "type": "string"
                },
                "promptIndex": {
                  "description": "Restrict to one turn.",
                  "type": "integer"
                },
                "aroundIndex": {
                  "description": "Center the page on this event index.",
                  "type": "integer"
                },
                "atIndex": {
                  "description": "Return the single event at this index.",
                  "type": "integer"
                },
                "contentChars": {
                  "description": "Body character cap (owner clamps to its ceiling).",
                  "type": "integer"
                }
              },
              "required": [
                "session"
              ]
            },
            "result": {
              "title": "session/timeline result",
              "type": "object",
              "additionalProperties": true,
              "properties": {}
            }
          },
          "required": [
            "params"
          ]
        },
        "session/turns": {
          "description": "Turn segments plus `subagentRuns` (turn-scoped child runs; `openable` + `childPath`).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "params": {
              "title": "session/turns params",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "session": {
                  "description": "Session id or path.",
                  "type": "string"
                },
                "query": {
                  "description": "Turns query language (same tokens as the Turns search box).",
                  "type": "string"
                }
              },
              "required": [
                "session"
              ]
            },
            "result": {
              "title": "session/turns result",
              "type": "object",
              "additionalProperties": true,
              "properties": {}
            }
          },
          "required": [
            "params"
          ]
        },
        "session/diff": {
          "description": "Rewind snapshots or approximate file edits (files + hunks + prompt/assistant text)",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "params": {
              "title": "session/diff params",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "session": {
                  "description": "Session id or path.",
                  "type": "string"
                }
              },
              "required": [
                "session"
              ]
            },
            "result": {
              "title": "session/diff result",
              "type": "object",
              "additionalProperties": true,
              "properties": {}
            }
          },
          "required": [
            "params"
          ]
        },
        "session/open": {
          "description": "Resolve a session and notify `session/selected`",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "params": {
              "title": "session/open params",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "session": {
                  "description": "Session id or path.",
                  "type": "string"
                },
                "promptIndex": {
                  "description": "Turn / prompt index.",
                  "type": "integer"
                }
              },
              "required": [
                "session"
              ]
            },
            "result": {
              "title": "session/open result",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "opened": {
                  "description": "True when the session resolved.",
                  "type": "boolean"
                }
              }
            }
          },
          "required": [
            "params"
          ]
        },
        "session/import": {
          "description": "Open a harness archive or anqa export and add it to the catalog",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "params": {
              "title": "session/import params",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "path": {
                  "description": "Archive, export bundle, or session directory.",
                  "type": "string"
                }
              },
              "required": [
                "path"
              ]
            },
            "result": {
              "title": "session/import result",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "session": {
                  "description": "Catalog path or `harness:id` for later methods.",
                  "type": "string"
                },
                "sessionId": {
                  "description": "Product session id.",
                  "type": "string"
                },
                "harness": {
                  "description": "Adapter id.",
                  "type": "string"
                },
                "imported": {
                  "description": "True when the session lives under the import store.",
                  "type": "boolean"
                },
                "replaced": {
                  "description": "True when a previous import of this id was overwritten.",
                  "type": "boolean"
                },
                "opened": {
                  "description": "True when the session resolved.",
                  "type": "boolean"
                }
              }
            }
          },
          "required": [
            "params"
          ]
        },
        "session/render": {
          "description": "Project a document (`format`: below)",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "params": {
              "title": "session/render params",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "session": {
                  "description": "Session id or path.",
                  "type": "string"
                },
                "format": {
                  "description": "Projection: `org` (default), `markdown`, or `json`.",
                  "type": "string"
                }
              },
              "required": [
                "session"
              ]
            },
            "result": {
              "title": "session/render result",
              "type": "object",
              "additionalProperties": true,
              "properties": {}
            }
          },
          "required": [
            "params"
          ]
        },
        "diagnostics": {
          "description": "Active RPC, recent bounded failures, and whether the catalog is building",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "params": {
              "title": "diagnostics params",
              "type": "object",
              "additionalProperties": true,
              "properties": {}
            },
            "result": {
              "title": "diagnostics result",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "active": {
                  "description": "In-flight methods (`method`, `elapsedMs`, `session`).",
                  "type": "array"
                },
                "failures": {
                  "description": "Recent bounded RPC failures (`method`, `code`, `message`, `elapsedMs`).",
                  "type": "array"
                },
                "catalogBuilding": {
                  "description": "True while a catalog store scan is in flight.",
                  "type": "boolean"
                }
              }
            }
          },
          "required": [
            "params"
          ]
        },
        "notes/list": {
          "description": "Notes snapshot (`revision`, schema, notes)",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "params": {
              "title": "notes/list params",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "session": {
                  "description": "Session id or path.",
                  "type": "string"
                }
              },
              "required": [
                "session"
              ]
            },
            "result": {
              "title": "notes/list result",
              "type": "object",
              "additionalProperties": true,
              "properties": {}
            }
          },
          "required": [
            "params"
          ]
        },
        "notes/upsert": {
          "description": "Write a note (`expectedRevision`)",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "params": {
              "title": "notes/upsert params",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "session": {
                  "description": "Session id or path.",
                  "type": "string"
                },
                "note": {
                  "title": "note",
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "source": {
                      "description": "Who wrote the note.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "source"
                  ],
                  "description": "Note object to write."
                },
                "expectedRevision": {
                  "description": "Notes revision the client last read.",
                  "type": "string"
                }
              },
              "required": [
                "session",
                "note"
              ]
            },
            "result": {
              "title": "notes/upsert result",
              "type": "object",
              "additionalProperties": true,
              "properties": {}
            }
          },
          "required": [
            "params"
          ]
        },
        "notes/delete": {
          "description": "Delete a note (`expectedRevision`)",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "params": {
              "title": "notes/delete params",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "session": {
                  "description": "Session id or path.",
                  "type": "string"
                },
                "noteId": {
                  "description": "Note id to delete.",
                  "type": "string"
                },
                "expectedRevision": {
                  "description": "Notes revision the client last read.",
                  "type": "string"
                }
              },
              "required": [
                "session",
                "noteId"
              ]
            },
            "result": {
              "title": "notes/delete result",
              "type": "object",
              "additionalProperties": true,
              "properties": {}
            }
          },
          "required": [
            "params"
          ]
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session/selected",
        "session/changed",
        "notes/changed"
      ],
      "properties": {
        "session/selected": {
          "description": "After `session/open`",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "params": {
              "title": "session/selected params",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "sessionId": {
                  "description": "Session directory name.",
                  "type": "string"
                },
                "promptIndex": {
                  "description": "Turn / prompt index.",
                  "type": "integer"
                }
              }
            }
          },
          "required": [
            "params"
          ]
        },
        "session/changed": {
