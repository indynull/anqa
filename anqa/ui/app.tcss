/* ── anqa theme ──────────────────────────────────────────────────────── */

Screen {
    background: $surface;
}

/* Modals: dim the stack underneath (translucent overlay) so the prior screen
   remains visible — dialog bodies stay opaque ($surface / $panel). */
ModalScreen {
    align: center middle;
    background: $background 32%;
}

ModalScreen:ansi {
    background: transparent;
}

/* Multiline editors: tall border uses 1 row top+bottom; keep ≥2 content lines
   so Enter does not look like the field was cleared. */
TextArea {
    min-height: 4;
}

/* ── Header / Footer ──────────────────────────────────────────────────── */

ActivityBar,
#activity-bar {
    dock: none;
    height: 1;
    width: 1fr;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
    content-align: right middle;
    text-align: right;
}

Footer {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

Footer FooterKey .footer-key--key {
    color: $text;
    text-style: bold;
    padding: 0;
}

Footer FooterKey .footer-key--description {
    color: $text-muted;
    padding: 0 0 0 1;
}

Footer KeyGroup.-compact {
    margin: 0 1 0 0;
    padding-left: 1;
    border-left: vkey $secondary;
}

Footer FooterKey.-command-palette {
    border-left: vkey $secondary;
    padding-right: 0;
}

/* ── Self-test modal ─────────────────────────────────────────────────── */

#self-test-modal {
    width: 72;
    height: auto;
    max-height: 90%;
    layout: vertical;
    padding: 1 2;
    background: $surface;
    border: thick $primary;
}

#self-test-title {
    text-style: bold;
    margin-bottom: 1;
}

#self-test-body {
    height: 1fr;
    min-height: 3;
    max-height: 28;
    overflow-y: auto;
    margin-bottom: 0;
}

#self-test-actions {
    dock: bottom;
    height: auto;
    min-height: 3;
    align: left middle;
    padding: 1 0 0 0;
    background: $surface;
}

#self-test-actions Button {
    margin-right: 1;
}

/* ── Trace Browser ────────────────────────────────────────────────────── */

#browser-tabs {
    height: 1fr;
}

TabPane {
    height: 1fr;
    layout: vertical;
}

#browser-layout {
    layout: horizontal;
    height: 1fr;
}

#timeline-panel {
    width: 3fr;
    height: 1fr;
    layout: vertical;
}

#detail-column {
    width: 2fr;
    height: 1fr;
    layout: vertical;
}

#detail-panel {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

#browser-layout.event-reader #timeline-panel {
    width: 0;
    min-width: 0;
    overflow: hidden;
    border: none;
}

#timeline-sash {
    margin: 0;
}

#browser-layout.event-reader #timeline-sash {
    display: none;
    width: 0;
}

#browser-layout.event-reader #detail-column {
    width: 1fr;
}

#timeline-list {
    height: 1fr;
    min-height: 5;
}

/* Tall focus border is a second divider next to the sash. */
#timeline-list:focus {
    border: solid $primary-background;
}

#timeline-list:focus > .datatable--header {
    background: $accent;
    color: $text;
}

/* ── Session load bar (main screen) ───────────────────────────────────── */
/* Do not force height: 1 on toolbars that contain Input/Button — clips chrome. */

#session-summary {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

/* ── Shared filter bars (sessions, Timeline) ─────────────────── */
/* Sit in the vertical stack (not dock: top) so TabPane layout is stable.   */
/* See widgets/controls.py — label + Select, never chips. */

#session-filter-bar,
#filter-bar,
.filter-bar {
    height: auto;
    min-height: 3;
    width: 100%;
    padding: 0 1;
    layout: horizontal;
    align: left middle;
    background: $surface;
    border-bottom: solid $primary-background;
}

#filter-view-label,
.filter-view-label {
    width: auto;
    height: auto;
    min-height: 3;
    content-align: left middle;
    padding: 0 1 0 0;
    text-style: bold;
    color: $text;
}

/* Timeline View — short option labels (All events, Tools only, …). */
#timeline-view-select {
    width: 24;
    min-width: 20;
    max-width: 32;
    height: auto;
    margin: 0 1 0 0;
}

/* Sessions list — Model + Task selects (orthogonal filters). */
#session-model-select,
.session-filter-select {
    width: 1fr;
    min-width: 16;
    max-width: 40;
    height: auto;
    margin: 0 1 0 0;
}

#timeline-view-select > SelectCurrent,
#session-model-select > SelectCurrent,
.session-filter-select > SelectCurrent {
    background: $boost;
    border: solid $primary;
    color: $text;
    height: auto;
    min-height: 3;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#session-model-select > SelectCurrent,
.session-filter-select > SelectCurrent {
    /* Prefer full labels; bar already allows wide select */
    width: 100%;
}

#timeline-view-select:focus > SelectCurrent,
#session-model-select:focus > SelectCurrent,
.session-filter-select:focus > SelectCurrent {
    border: solid $accent;
    background: $surface-lighten-1;
}

/* Dropdown list options should not squeeze plugin names either */
#session-model-select > SelectOverlay,
.session-filter-select > SelectOverlay {
    min-width: 100%;
    width: auto;
    max-width: 80;
}

#timeline-filter-grow {
    width: 1fr;
    height: 1;
    min-height: 1;
}

#timeline-tail-cluster {
    width: auto;
    height: 3;
    min-height: 3;
    max-height: 3;
    layout: horizontal;
    align: left middle;
}

#timeline-tail-label {
    width: auto;
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    padding: 0 1 0 0;
    content-align: left middle;
}

#timeline-tail {
    width: auto;
    min-width: 4;
    max-width: 6;
    height: 1;
    min-height: 1;
    max-height: 1;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}

#event-view-bar {
    dock: top;
    height: 3;
    min-height: 3;
    max-height: 3;
}

#event-raw-cluster {
    width: auto;
    height: 3;
    min-height: 3;
    max-height: 3;
    layout: horizontal;
    align: left middle;
}

#event-raw-label {
    width: auto;
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    padding: 0 1 0 0;
    content-align: left middle;
}

#event-raw {
    width: auto;
    min-width: 4;
    max-width: 6;
    height: 1;
    min-height: 1;
    max-height: 1;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}

#filter-bar Input,
#session-filter-bar Input,
#timeline-search-bar Input {
    width: 1fr;
    height: auto;
    min-height: 3;
    border: solid $primary-background;
    padding: 0 1;
    margin: 0 0 0 1;
    background: $surface-darken-1;
    color: $text;
}

#timeline-search-bar Input {
    margin: 0;
}

#filter-bar Input:focus,
#session-filter-bar Input:focus,
#timeline-search-bar Input:focus {
    border: solid $accent;
    background: $surface;
}

.session-query-hints {
    color: $text-muted;
    height: 1;
    min-height: 1;
    max-height: 1;
    padding: 0 1 0 2;
}

/* Notes — one scroll of note cards. */
#notes-panel {
    height: 1fr;
    layout: vertical;
}

#notes-scroll {
    height: 1fr;
}

.note-card-list {
    height: auto;
}

/* ── Selects — natural height, light chrome (no height:1 clipping) ───── */

Select {
    height: auto;
    margin: 0 0 1 0;
}

Select > SelectCurrent {
    height: auto;
    min-height: 3;
    background: $surface;
    border: solid $primary-background;
    color: $text;
    padding: 0 1;
}

Select > SelectCurrent Static#label {
    color: $text;
    background: transparent;
}

Select > SelectCurrent .arrow {
    color: $text-muted;
}

Select:focus > SelectCurrent {
    border: solid $accent;
    background: $surface-lighten-1;
}

/* Pop-up list must beat Textual's ``Select > SelectOverlay { border: tall
 * $border-blurred }`` (higher specificity than a bare SelectOverlay rule).
 * Dark heavy outer border + accent outline = cutout over table rows. */
Select > SelectOverlay,
Select.-expanded > SelectOverlay,
SelectOverlay {
    /* Solid panel. */
    background: $boost !important;
    /* Outside: opaque black frame (stronger than theme “darken” tokens). */
    border: heavy #000000 !important;
    /* Inside rim: accent (yellow on many themes) — Textual outline sits on the widget. */
    outline: tall $accent !important;
    padding: 1 2;
    max-height: 12;
    /* Kill inherited tint/blur that made the menu look like another list row. */
    background-tint: $foreground 0%;
}

Select > SelectOverlay:focus,
SelectOverlay:focus {
    border: heavy #000000 !important;
    outline: wide $accent !important;
    background: $boost !important;
}

/* Options: padding + highlight, unlike the DataTable cursor. */
Select > SelectOverlay > .option-list--option,
SelectOverlay > .option-list--option {
    padding: 0 1;
    background: transparent;
}

Select > SelectOverlay > .option-list--option-highlighted,
SelectOverlay > .option-list--option-highlighted,
Select > SelectOverlay:focus > .option-list--option-highlighted,
SelectOverlay:focus > .option-list--option-highlighted {
    background: $accent !important;
    color: $background !important;
    text-style: bold;
}

.field-select {
    min-width: 16;
}

/* ── Detail View ──────────────────────────────────────────────────────── */

#detail-content {
    padding: 1 2;
    height: 1fr;
    overflow-y: auto;
}

#detail-header {
    height: auto;
    padding: 1 2;
    background: $panel;
    border-bottom: solid $primary-lighten-2;
}

.event-badge {
    padding: 0 1;
    margin: 0 1;
}

.event-badge-user {
    background: $success;
    color: $text;
}

.event-badge-assistant {
    background: $primary;
    color: $text;
}

.event-badge-thought {
    background: $surface-lighten-2;
    color: $text-muted;
}

.event-badge-tool_call {
    background: $accent;
    color: $text;
}

.event-badge-tool_result {
    background: $warning;
    color: $text;
}

.event-badge-error {
    background: $error;
    color: $text;
    text-style: bold;
}

.event-badge-plan {
    background: $warning;
    color: $text;
}

.event-badge-subagent {
    background: $warning;
    color: $text;
}

/* ── Issues Panel ─────────────────────────────────────────────────────── */

#issues-list {
    height: 1fr;
}

.issue-row {
    height: auto;
    padding: 1 2;
    border-bottom: solid $surface-lighten-1;
}

.issue-row:hover {
    background: $boost;
}

.severity-high {
    color: $error;
    text-style: bold;
}

.severity-medium {
    color: $warning;
}

.severity-low {
    color: $text-muted;
}

#discard-confirm-modal {
    width: 56;
    height: auto;
    max-height: 90%;
    layout: vertical;
    padding: 1 2;
    background: $surface;
    border: thick $warning;
}

#discard-confirm-title {
    margin: 0 0 1 0;
}

#discard-confirm-body {
    margin: 0 0 1 0;
    color: $text-muted;
}

#discard-confirm-actions {
    dock: bottom;
    height: auto;
    min-height: 3;
    align: left middle;
    padding: 1 0 0 0;
    background: $surface;
}

#discard-confirm-actions Button {
    margin-right: 1;
}

/* Booleans: label + [ ] / [x]. Room for focus border so the label never clips. */
Checkbox {
    width: 100%;
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $boost;
    color: $text;
    border: tall $panel;
}

Checkbox:focus {
    background: $primary 20%;
    color: $text;
    text-style: bold;
    border: tall $accent;
}

Checkbox.-on {
    color: $success;
    background: $boost;
    text-style: bold;
}

Checkbox.-on:focus {
    color: $success;
    background: $primary 20%;
    border: tall $accent;
}

/* Legacy Switch (if any remain): keep compact, don't inflate to 3 rows */
Switch {
    width: auto;
    height: 1;
    min-width: 7;
    background: $panel;
    border: none;
    padding: 0 1;
    margin: 0 0 0 1;
}

Switch .switch--slider {
    background: $surface-darken-1;
    color: $text-muted;
}

Switch.-on .switch--slider {
    color: $success;
    background: $success 20%;
}

/* ── Tabs ─────────────────────────────────────────────────────────────── */

ContentSwitcher {
    height: 1fr;
}

/* Shared card frame for non-table blocks AND table hosts (matches DataTable border) */
.panel-card {
    height: auto;
    layout: vertical;
    background: $surface;
    border: solid $primary-background;
    padding: 1;
    margin: 0 0 1 0;
    color: $text;
}

.panel-card-grow {
    height: 1fr;
    min-height: 8;
    margin-bottom: 0;
}

.panel-card-title {
    height: auto;
    padding: 0 0 1 0;
    text-style: bold;
    color: $text;
}

.panel-card-head {
    height: auto;
    width: 100%;
    layout: horizontal;
}

.panel-card-head > .panel-card-title {
    width: 1fr;
    padding: 0 1 1 0;
}

.panel-card.note-focused {
    background: $primary-background;
    border: solid $primary;
    text-style: bold;
}

.note-source-badge {
    width: auto;
    height: 1;
    padding: 0 1;
    background: $primary;
    color: $text;
    text-style: bold;
}

/* Content sits inside .panel-card — no second border on the Static */
#summary-content,
#diff-content,
#diff-prompt,
#diff-assistant {
    height: auto;
    padding: 0;
    color: $text;
    background: transparent;
    border: none;
}

/* Extractable bodies stay focusable for Tab + y; no raise chrome on click. */

/* Scroll hosts: page background; cards provide the frames */
#summary-tabs {
    height: 1fr;
}

#summary-session-scroll,
#summary-tasks-scroll,
#summary-workflows-scroll,
#summary-subagents-scroll,
#summary-stats-scroll,
#notes-scroll,
#diff-scroll,
#stats-scroll {
    height: 1fr;
    background: $background;
    padding: 1 1 0 1;
}

#diff-view {
    height: 1fr;
    layout: vertical;
    padding: 1 1 0 1;
    background: $background;
}

#diff-chrome {
    height: 10;
    min-height: 8;
    layout: horizontal;
    background: $surface;
    border: solid $primary-background;
    margin: 0 0 1 0;
}

#diff-filter-bar {
    width: 28;
    min-width: 20;
    height: 1fr;
    layout: vertical;
    padding: 0 1;
    border: none;
    border-right: solid $primary-lighten-2;
    background: $surface;
}

#diff-filter-label {
    min-height: 1;
    height: auto;
    padding: 0 0 1 0;
}

#diff-point-select {
    width: 100%;
}

#diff-context {
    width: 1fr;
    height: 1fr;
    layout: vertical;
    background: $surface;
    border: none;
    padding: 0;
    margin: 0;
}

#diff-context-tabs {
    height: 1fr;
}

#diff-context-tabs ContentSwitcher {
    height: 1fr;
    border-top: solid $primary-background;
}

#diff-context-tabs UnderlineTab.-active,
#diff-context-tabs Tab.-active {
    text-style: bold;
    color: $text;
    background: $primary 20%;
}

#diff-prompt-scroll,
#diff-assistant-scroll {
    height: 1fr;
    padding: 0 1;
}

#diff-search-bar {
    margin: 0 0 1 0;
}

#diff-search-bar Input {
    width: 1fr;
    height: auto;
    min-height: 3;
    border: solid $primary-background;
    padding: 0 1;
    background: $surface-darken-1;
    color: $text;
}

#diff-search-bar Input:focus {
    border: solid $accent;
    background: $surface;
}

#diff-search-count {
    color: $text-muted;
    width: auto;
    min-width: 8;
    content-align: right middle;
    padding: 0 1;
}

#diff-search-prev,
#diff-search-next {
    width: auto;
    min-width: 10;
    height: auto;
    min-height: 3;
}

#diff-layout {
    height: 1fr;
    layout: horizontal;
    background: $surface;
    border: solid $primary-background;
}

#diff-files {
    width: 36;
    min-width: 18;
    height: 1fr;
    padding: 0;
    border-right: solid $primary-lighten-2;
}

#diff-file-list {
    height: 1fr;
    min-height: 8;
    border: none;
    background: $surface-darken-1;
}

#diff-scroll {
    width: 1fr;
    height: 1fr;
    padding: 1;
    background: $background;
}

/* Tables inside cards: no double outer border (card already frames) */
.summary-pair {
    height: auto;
    layout: horizontal;
}

.summary-pair > .panel-card {
    width: 1fr;
    margin: 0 1 1 0;
}

/* Narrow window: stack the pair instead of squeezing two tables. */
#summary-session-scroll.summary-stack .summary-pair,
#summary-tasks-scroll.summary-stack .summary-pair,
#summary-stats-scroll.summary-stack .summary-pair {
    layout: vertical;
}

#summary-session-scroll.summary-stack .summary-pair > .panel-card,
#summary-tasks-scroll.summary-stack .summary-pair > .panel-card,
#summary-stats-scroll.summary-stack .summary-pair > .panel-card {
    width: 100%;
    margin: 0 0 1 0;
}

.panel-card DataTable {
    height: auto;
    min-height: 5;
    max-height: 18;
    margin: 0;
    border: none;
    background: $surface-darken-1;
}

/* Same box as unfocused: a tall focus border shifts rows under the click. */
.panel-card DataTable:focus {
    border: none;
}

.panel-card DataTable:focus > .datatable--header {
    background: $accent;
    color: $text;
}

/* Focused browser pane tab — accent from user theme (lazygit-style active edge) */
#browser-tabs UnderlineTab.-active,
#browser-tabs Tab.-active,
#summary-tabs UnderlineTab.-active,
#summary-tabs Tab.-active {
    text-style: bold;
    color: $text;
    background: $primary 20%;
}

#browser-tabs ContentSwitcher,
#summary-tabs ContentSwitcher {
    height: 1fr;
    border-top: solid $primary-background;
}

#detail-sections {
    height: auto;
}

#detail-sections .panel-card {
    margin: 0 0 1 0;
}

#detail-body,
.detail-section-body {
    height: auto;
    padding: 0;
}

#detail-images {
    height: auto;
}

#detail-images .detail-still,
#detail-image {
    width: 100%;
    height: auto;
    max-height: 24;
    margin: 1 0 0 0;
}

/* ── DataTable — frame (theme tokens) ─ */

DataTable {
    height: 1fr;
    background: $surface;
    color: $text;
    border: solid $primary-background;
}

DataTable > .datatable--header {
    background: $surface;
    color: $text-muted;
    text-style: bold;
}

DataTable > .datatable--header-cursor {
    background: $primary-background;
    color: $text;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary-background;
    color: $text;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $boost;
}

DataTable > .datatable--fixed {
    background: $panel;
}

/* ── Modals ───────────────────────────────────────────────────────────── */

ModalScreen {
    align: center middle;
}

/* Help modal styles: HelpModal.DEFAULT_CSS in widgets/help_modal.py */

#modal-container {
    width: 80;
    height: auto;
    max-height: 90%;
    layout: vertical;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#modal-container.import-path {
    height: 28;
}

#modal-container.import-path #import-path-tree {
    height: 1fr;
    min-height: 10;
    margin: 1 0;
}

#modal-container.tags-modal {
    width: 60;
}

#tags-chips {
    height: auto;
    margin: 1 0;
}

#tags-chips Button.tag-chip {
    margin: 0 1 1 0;
    height: 1;
    color: $primary;
    background: $primary-background;
    border: none;
}

#tags-actions {
    margin-top: 1;
}

#notes-modal-body SelectionList.note-field-choices {
    height: auto;
    max-height: 10;
    margin-bottom: 1;
}


#modal-container Button {
    margin: 0 1 0 0;
    height: 1;
}

/* Shared modal footer class (always visible action row) */
.modal-footer {
    dock: bottom;
    height: auto;
    min-height: 3;
    align: left middle;
    margin: 0;
    padding: 1 0;
    background: $surface;
}

/* ── Buttons — quiet terminal links/actions (avoid blocky "toggle" look) ─ */

Button {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
    margin: 0 1 0 0;
    background: transparent;
    color: $text;
    text-style: none;
}

Button:hover {
    color: $accent;
    background: transparent;
    text-style: underline;
}

Button:focus {
    background: $surface-lighten-1;
    text-style: none;
    color: $text;
}

/* Keyboard focus — visible for Tab navigation (AGENTS.md TUI patterns) */
DataTable:focus {
    border: tall $accent;
}

/* Do NOT apply to CommandPalette: Textual's CommandInput uses border: blank and
   a horizontal icon+input row; tall focus borders misalign the search popup. */
Input:focus,
TextArea:focus,
Checkbox:focus,
OptionList:focus {
    border: tall $accent;
}

CommandPalette Input,
CommandPalette Input:focus,
CommandPalette OptionList,
CommandPalette OptionList:focus {
    border: blank;
}

/* Select focus is on SelectCurrent (see Select rules above), not the outer widget */
Select:focus {
    border: none;
}


/* Real action buttons (toolbars, modals) — subtle pill, not a filled block */
Button.-primary {
    background: $primary-darken-2;
    color: $text;
    text-style: bold;
}

Button.-primary:hover {
    background: $primary;
    color: $text;
    text-style: bold;
}

Button.-primary:focus {
    background: $primary;
    text-style: bold;
}

Button.-error {
    color: $error;
    background: transparent;
}

Button.-error:hover {
    background: $error-darken-2;
    color: $text;
}

Button:disabled {
    color: $text-muted;
    background: transparent;
    text-style: dim;
    opacity: 50%;
}

/* SelectionList: same cutout frame as Select overlays */
SelectionList {
    background: $boost !important;
    border: heavy #000000 !important;
    outline: tall $accent !important;
    padding: 1 2;
    background-tint: $foreground 0%;
}

SelectionList:focus {
    border: heavy #000000 !important;
    outline: wide $accent !important;
}

SelectionList > .selection-list--option {
    padding: 0 1;
}

SelectionList > .selection-list--option-highlighted {
    background: $accent !important;
    color: $background !important;
    text-style: bold;
}

/* ── Loading indicator ────────────────────────────────────────────────── */

LoadingIndicator {
    height: auto;
}

/* ── Utility ──────────────────────────────────────────────────────────── */

.hidden {
    display: none;
}

.text-error { color: $error; }
.text-warning { color: $warning; }
.text-success { color: $success; }
.text-muted { color: $text-muted; }
/* ── Run configs screen ──────────────────────────────────────────────── */
#rc-banner {
    padding: 1 2;
    height: auto;
}

#rc-selection-status {
    padding: 0 2 0 2;
    height: auto;
    color: $text-muted;
}

#rc-selection-tip {
    padding: 0 2 1 2;
    height: auto;
}

#rc-table {
    height: 1fr;
    min-height: 10;
    margin: 0 1;
}

#rc-detail {
    padding: 1 2;
    height: auto;
    max-height: 10;
    border-top: solid $primary-lighten-2;
}

#rc-actions {
    height: auto;
    padding: 1 2;
}

#rc-actions Button {
    margin-right: 1;
}

